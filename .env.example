# TRACEFUSE configuration. Copy to backend/.env (git-ignored). Never commit real values.
# Every credential is OPTIONAL: missing ones are reported as "unconfigured" — nothing is mocked.

# --- Chain data -----------------------------------------------------------------------------------
# Etherscan API V2 (https://docs.etherscan.io). Free tier covers Ethereum (1) and Arbitrum One (42161);
# OP Mainnet (10) and Base (8453) are paid-tier only per Etherscan's supported-chains page.
ETHERSCAN_API_KEY=
# Alchemy (alchemy_getAssetTransfers). Enables Base / Arbitrum / OP via Alchemy networks.
ALCHEMY_API_KEY=

# --- OSINT ----------------------------------------------------------------------------------------
# GitHub REST API token (fine-grained, public read-only is enough). Enables code search and raises
# search rate limits from 10/min to 30/min. Without it, issues + commits search still run.
GITHUB_TOKEN=
# GoPlus Security access token (optional; the Malicious Address API also works keyless with lower limits).
GOPLUS_ACCESS_TOKEN=

# --- Runtime --------------------------------------------------------------------------------------
# TRACEFUSE_DB_PATH=backend/var/tracefuse.sqlite3
# TRACEFUSE_DATA_DIR=backend/data
# CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# LOG_LEVEL=INFO
# MAX_PROVIDER_CALLS_PER_INVESTIGATION=600
# MAX_GITHUB_QUERIES_PER_INVESTIGATION=6
# MAX_GOPLUS_LOOKUPS_PER_INVESTIGATION=25

# Frontend (only if the API is not served from the same origin / Vite proxy):
# VITE_API_BASE=http://127.0.0.1:8000
